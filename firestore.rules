// Firestore security rules for the iLovah CRM
// Deploy with: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // LEADS - public can CREATE (the quote form), only admins can read/update.
    match /leads/{leadId} {
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 200 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 0 &&
        request.resource.data.phone.size() < 50 &&
        request.resource.data.status == 'new';

      allow read, update, delete: if request.auth != null;
    }

    // BLOG - public can read published posts only; admin can do everything.
    match /blog/{slug} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;
    }

    // CLIENTS, JOBS, SETTINGS - admin only.
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
    }
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
